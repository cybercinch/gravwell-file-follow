# ── Gravwell ingester ──────────────────────────────────────────────────────────
# Authentication secret — must match your Gravwell server's Ingest-Auth value.
GRAVWELL_INGEST_SECRET=change_me_please

# Target Gravwell ingestor address (cleartext on port 4023).
# Comma-separated for multiple targets: 10.0.0.1:4023,10.0.0.2:4023
GRAVWELL_CLEARTEXT_TARGETS=172.16.37.18:4023

# Uncomment to use TLS (port 4024).
# GRAVWELL_ENCRYPTED_TARGETS=172.16.37.18:4024

# Set to true when using self-signed or private CA certificates.
INSECURE_SKIP_TLS_VERIFY=true

# Gravwell ingester log verbosity: INFO, WARN, ERROR, OFF
GRAVWELL_LOG_LEVEL=INFO

# Gravwell version to build from source (git tag).
GRAVWELL_VERSION=v3.8.76

# Optional: path to a PEM CA certificate to trust for TLS connections.
# Pass at build time: docker buildx build --build-arg CUSTOM_CA=my-ca.crt
# Leave unset to use the default system trust store only.
# CUSTOM_CA=

# ── docker-log-watcher ────────────────────────────────────────────────────────
# Seconds to wait after the last event before restarting gravwell_file_follow.
# Prevents rapid restarts when a whole compose stack comes up at once.
WATCHER_DEBOUNCE_SECS=2

# Watcher log verbosity: debug, info, warn, error
WATCHER_LOG_LEVEL=info

# Default Gravwell tag when a container has no name and no gravwell.tag label.
WATCHER_DEFAULT_TAG=docker

# Comma-separated container names to always skip (in addition to gravwell.skip label).
# Example: WATCHER_EXCLUDE_NAMES=portainer,traefik
WATCHER_EXCLUDE_NAMES=

# Optional: Enable debug mode (prints rendered base config on startup).
# DEBUG=false
